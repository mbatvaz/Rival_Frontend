{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Rival: Install Dependencies",
      "type": "shell",
      "command": "npm ci --cache .npm-cache",
      "problemMatcher": []
    },
    {
      "label": "Rival: Install Playwright Chromium",
      "type": "shell",
      "command": "npm run install:browsers",
      "problemMatcher": []
    },
    {
      "label": "Rival: Build Static Preview",
      "type": "npm",
      "script": "build",
      "problemMatcher": []
    },
    {
      "label": "Rival: Dev Preview",
      "type": "shell",
      "command": "npm run -s dev -- --host 127.0.0.1 --port 8183",
      "isBackground": true,
      "problemMatcher": {
        "owner": "rival",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): (.*)$",
          "file": 1, "line": 2, "column": 3, "message": 4
        },
        "background": { "activeOnStart": true, "beginsPattern": "^Rival", "endsPattern": "^Rival preview:" }
      }
    },
    {
      "label": "Rival: Documentation + Skill Checks",
      "type": "npm",
      "script": "lint:docs",
      "problemMatcher": []
    },
    {
      "label": "Rival: Affected QA",
      "type": "npm",
      "script": "qa:affected",
      "problemMatcher": []
    },
    {
      "label": "Rival: Full Phase QA",
      "type": "shell",
      "command": "npm run -s qa:affected -- --full",
      "problemMatcher": []
    }
  ]
}
