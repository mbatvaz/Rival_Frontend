{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Rival: Install Dependencies",
      "type": "shell",
      "command": "npm install --cache .npm-cache",
      "problemMatcher": []
    },
    {
      "label": "Rival: Install Playwright Chromium",
      "type": "shell",
      "command": "npm run install:browsers",
      "problemMatcher": []
    },
    {
      "label": "Rival: Build Static Preview",
      "type": "npm",
      "script": "build",
      "problemMatcher": []
    },
    {
      "label": "Rival: Start Local Preview",
      "type": "npm",
      "script": "preview:server",
      "isBackground": true,
      "problemMatcher": {
        "owner": "rival",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): (.*)$",
          "file": 1, "line": 2, "column": 3, "message": 4
        },
        "background": { "activeOnStart": true, "beginsPattern": "^Rival", "endsPattern": "^Rival preview:" }
      }
    },
    {
      "label": "Rival: Build + Preview",
      "dependsOn": ["Rival: Build Static Preview", "Rival: Start Local Preview"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Rival: Structure Lint",
      "type": "npm",
      "script": "lint:structure",
      "problemMatcher": []
    },
    {
      "label": "Rival: Documentation + Skill Checks",
      "type": "npm",
      "script": "lint:docs",
      "problemMatcher": []
    },
    {
      "label": "Rival: JavaScript + CSS Lint",
      "type": "shell",
      "command": "npm run lint:js && npm run lint:css",
      "problemMatcher": []
    },
    {
      "label": "Rival: All Foundation Tests",
      "type": "npm",
      "script": "test",
      "problemMatcher": []
    },
    {
      "label": "Rival: Test Subfolder Deployment",
      "type": "npm",
      "script": "test:subpath",
      "problemMatcher": []
    },
    {
      "label": "Rival: Visual Tests",
      "type": "npm",
      "script": "test:visual",
      "problemMatcher": []
    },
    {
      "label": "Rival: Accessibility Tests",
      "type": "npm",
      "script": "test:a11y",
      "problemMatcher": []
    }
  ]
}
