{% extends "Shared/_AuthLayout.njk" %}
{% block content %}
  <section data-rv="complete-profile">
    <header class="rv-auth-hero"><a href="{{ urls.home }}" aria-label="ریوال — خانه"><img src="{{ urls.logo }}" alt="ریوال" width="150" height="50"></a><h1>خوش آمدید</h1><p>فقط نامتان را بنویسید تا آرایشگر بداند نوبت برای کیست.</p></header>
    <form class="rv-panel rv-auth-form" action="{{ productUrls.complete }}" method="post" data-rv-profile-form novalidate>
      <!-- MVC:ANTIFORGERY -->
      <p class="rv-auth-return" data-rv-auth-return hidden>بعد از این مرحله به رزرو نوبت برمی‌گردید.</p>
      <p class="rv-muted" data-rv-verified-phone></p>
      <div class="rv-field"><label for="first-name">نام</label><div class="rv-input"><span class="ri ri-user" aria-hidden="true"></span><input id="first-name" name="firstName" autocomplete="given-name" placeholder="علی" aria-describedby="first-error" data-rv-first-name></div><p class="rv-field__error" id="first-error"></p></div>
      <div class="rv-field"><label for="last-name">نام خانوادگی</label><div class="rv-input"><span class="ri ri-user" aria-hidden="true"></span><input id="last-name" name="lastName" autocomplete="family-name" placeholder="رضایی" aria-describedby="last-error" data-rv-last-name></div><p class="rv-field__error" id="last-error"></p></div>
      <p role="alert" class="rv-field__error" data-rv-profile-error></p>
      <button class="rv-btn" type="submit">ادامه</button>
    </form>
  </section>
{% endblock %}
