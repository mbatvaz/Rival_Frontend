{% extends "Shared/_AuthLayout.njk" %}
{% block content %}
  <section data-rv="auth">
    <header class="rv-auth-hero"><a href="{{ urls.home }}" aria-label="ریوال — خانه"><img src="{{ urls.logo }}" alt="ریوال" width="150" height="50"></a><h1 data-rv-auth-title>ورود یا ثبت‌نام</h1><p data-rv-auth-description>با یک کد پیامکی، بدون رمز عبور</p></header>
    <form class="rv-panel rv-auth-form" method="post" action="{{ productUrls.login }}" novalidate data-rv-auth-form>
      <!-- MVC:ANTIFORGERY -->
      <p class="rv-auth-return" data-rv-auth-return hidden>بعد از ورود به <strong>رزرو نوبت</strong> برمی‌گردید.</p>
      <p class="rv-auth-lock" role="alert" data-rv-auth-lock hidden></p>
      <div class="rv-field"><label for="login-phone">شماره موبایل</label><div class="rv-input"><span class="ri ri-smartphone" aria-hidden="true"></span><input id="login-phone" name="phone" type="tel" inputmode="numeric" autocomplete="tel" maxlength="11" placeholder="۰۹۱۲ ۳۴۵ ۶۷۸۹" aria-describedby="phone-error" data-rv-phone><button type="button" data-rv-edit-phone hidden>ویرایش</button></div><p class="rv-field__error" id="phone-error" data-rv-phone-error></p></div>
      <div class="rv-field" data-rv-otp-stage hidden><label for="login-code">کد پیامک‌شده</label>{% include "Shared/Components/_Otp.njk" %}<p class="rv-field__error" id="code-error" data-rv-code-error></p><div class="rv-auth-timer"><button class="rv-text-link rv-auth-link" type="button" data-rv-resend>ارسال دوباره کد</button></div></div>
      <div class="rv-field" data-rv-password-stage hidden><label for="login-password">رمز عبور</label><div class="rv-input"><span class="ri ri-key" aria-hidden="true"></span><input id="login-password" name="password" type="password" autocomplete="current-password" placeholder="••••••••" aria-describedby="password-error" data-rv-password></div><p class="rv-field__error" id="password-error" data-rv-password-error></p></div>
      <p class="rv-feedback" role="status" data-rv-auth-status></p>
      <button class="rv-btn" type="submit" data-rv-auth-submit>دریافت کد</button>
      <button class="rv-text-link rv-auth-link" type="button" data-rv-auth-retry hidden>تلاش دوباره</button>
    </form>
    <div class="rv-auth-alternatives"><button class="rv-btn rv-btn--glass" type="button" data-rv-method="passkey" data-rv-passkey disabled><span class="ri ri-fingerprint" aria-hidden="true"></span>ورود با Passkey</button><button class="rv-btn rv-btn--glass" type="button" data-rv-method="password" data-rv-password-toggle disabled><span class="ri ri-key" data-rv-method-icon aria-hidden="true"></span><span data-rv-method-label>ورود با رمز عبور</span></button></div>
    <p class="rv-auth-demo" id="code-demo" data-rv-auth-demo></p>
  </section>
{% endblock %}
