{% extends "Shared/_PublicLayout.njk" %}
{% block content %}
  <div class="rv-public-content" data-rv="portfolio">
    <p class="rv-muted">کار واقعی آرایشگران سالن طاها. روی هر نمونه‌کار بزنید تا همه تصویرها و توضیحش را ببینید.</p>
    <div class="rv-filters">
      <div class="rv-filter" role="group" aria-label="فیلتر خدمت"><span>خدمت</span><div class="rv-chip-rail">{% for service in model.services %}<button class="rv-chip" type="button" data-rv-filter="service" data-rv-value="{{ service }}" aria-pressed="{% if loop.first %}true{% else %}false{% endif %}">{{ service }}</button>{% endfor %}</div></div>
      <div class="rv-filter" role="group" aria-label="فیلتر آرایشگر"><span>آرایشگر</span><div class="rv-chip-rail">{% for stylist in model.stylists %}<button class="rv-chip" type="button" data-rv-filter="stylist" data-rv-value="{{ stylist }}" aria-pressed="{% if loop.first %}true{% else %}false{% endif %}">{{ stylist }}</button>{% endfor %}</div></div>
    </div>
    {% include "Shared/Components/_PortfolioFeedback.njk" %}
    <section class="rv-portfolio-grid" aria-label="نمونه‌کارها">
      {% for item in model.items %}{% if item.lead %}{% include "Shared/Components/_PortfolioCard.njk" %}{% endif %}{% endfor %}
      <div class="rv-portfolio-columns">
        <div class="rv-portfolio-column">{% for item in model.items %}{% if item.column == 'right' %}{% include "Shared/Components/_PortfolioCard.njk" %}{% endif %}{% endfor %}</div>
        <div class="rv-portfolio-column">{% for item in model.items %}{% if item.column == 'left' %}{% include "Shared/Components/_PortfolioCard.njk" %}{% endif %}{% endfor %}</div>
      </div>
    </section>
    {% include "Shared/_BookingCta.njk" %}
  </div>
{% endblock %}
{% block sheets %}
  {% for item in model.items %}{% include "Shared/Components/_PortfolioViewer.njk" %}{% endfor %}
{% endblock %}
