{% extends "Shared/_PublicLayout.njk" %}
{% block content %}
  <div class="rv-public-content rv-rules">
    <section class="rv-rules__intro"><h2>پیش از پرداخت، این چند قاعده را بدانید</h2><p class="rv-muted">به زبان ساده: چطور رزرو می‌کنید، چه می‌پردازید، و اگر برنامه‌تان عوض شد چه می‌شود.</p><div class="rv-booking-cta"><div class="rv-rule-notice"><span class="rv-icon-tile"><span class="ri ri-check-circle" aria-hidden="true"></span></span><div><h3>پرداخت یعنی پذیرش این قوانین</h3><p>پیوند همین صفحه پیش از هر پرداخت کنار دکمه پرداخت هست.</p></div></div><div class="rv-rule-notice"><span class="rv-icon-tile"><span class="ri ri-receipt" aria-hidden="true"></span></span><div><h3>مبلغ آنلاین، هزینه رزرو است</h3><p>نه قیمت کامل خدمت.</p></div></div></div></section>
    <nav class="rv-rules__toc" data-rv-drag-rail aria-label="بخش‌های این صفحه"><a href="#book">رزرو</a><a href="#pay">پرداخت</a><a href="#cancel">لغو و جابه‌جایی</a><a href="#salon">تغییر از طرف سالن</a></nav>
    <div class="rv-rules__body">
      <section id="book"><h2 class="rv-rule-heading"><span>۱</span>رزرو</h2><ol class="rv-rule-ways rv-panel">{% for rule in model.book %}<li><span class="rv-icon-tile"><span class="ri ri-{{ rule.icon }}" aria-hidden="true"></span></span><div><h3>{{ rule.title }}</h3><p class="rv-muted">{{ rule.label }}</p><p>{{ rule.text }}</p></div></li>{% endfor %}</ol><ul class="rv-rule-notes">{% for note in model.bookNotes %}<li><span class="ri ri-{{ note.icon }}" aria-hidden="true"></span><span>{{ note.text }}</span></li>{% endfor %}</ul></section>
      <section id="pay"><h2 class="rv-rule-heading"><span>۲</span>پرداخت</h2><ul class="rv-rule-notes">{% for note in model.pay %}<li><span class="ri ri-{{ note.icon }}" aria-hidden="true"></span><span>{{ note.text }}</span></li>{% endfor %}</ul></section>
      <section id="cancel"><h2 class="rv-rule-heading"><span>۳</span>لغو و جابه‌جایی نوبت</h2><p class="rv-muted">همه چیز به این بستگی دارد که چقدر به شروع نوبت مانده است.</p><div class="rv-policy-bar" aria-hidden="true"><span></span><span></span><span></span></div><div class="rv-policy-labels" aria-hidden="true"><span>بیش از ۲۴ ساعت</span><span>۲۴ تا ۳ ساعت</span><span>کمتر از ۳</span></div>{% for window in model.windows %}{% include "Shared/Components/_PolicyWindow.njk" %}{% endfor %}<ul class="rv-rule-notes">{% for note in model.cancelNotes %}<li><span class="ri ri-{{ note.icon }}" aria-hidden="true"></span><span>{{ note.text }}</span></li>{% endfor %}</ul></section>
      <section id="salon"><h2 class="rv-rule-heading"><span>۴</span>وقتی سالن نوبت را تغییر می‌دهد</h2>{% for rule in model.salon %}<article class="rv-panel"><span class="rv-icon-tile"><span class="ri ri-{{ rule.icon }}" aria-hidden="true"></span></span><div><h3>{{ rule.title }}</h3><p>{{ rule.text }}</p></div></article>{% endfor %}</section>
      <aside class="rv-panel rv-rules-contact"><div><h3>سؤالی مانده؟</h3><p class="rv-muted">با سالن تماس بگیرید.</p></div><a class="rv-btn rv-btn--secondary" href="tel:{{ model.phone }}"><span class="ri ri-phone" aria-hidden="true"></span>تماس</a></aside>
    </div>
  </div>
{% endblock %}
