<div class="rv-booking-calendar">
  <div class="rv-booking-calendar__head">
    <strong data-rv-month-title aria-live="polite"></strong>
    <div class="rv-calendar-nav">
      <button class="rv-icon-btn" type="button" data-rv-month-move="-1" aria-label="ماه قبل"><span class="ri ri-chevron-right" aria-hidden="true"></span></button>
      <button class="rv-icon-btn" type="button" data-rv-month-move="1" aria-label="ماه بعد"><span class="ri ri-chevron-left" aria-hidden="true"></span></button>
    </div>
  </div>
  <div class="rv-booking-calendar__grid" data-rv-month-grid role="radiogroup" aria-label="روزهای ماه"></div>
</div>
