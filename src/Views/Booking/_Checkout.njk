<form class="rv-booking-form rv-booking-workspace rv-booking-checkout" data-rv-booking-form action="{{ bookingUrls['PAY-RES'] }}">
  <div class="rv-booking-checkout__ticket">
    <div class="rv-booking-desktop-only rv-booking-summary-head" data-rv-ticket-heading><h2>جزئیات نوبت</h2><span class="ri ri-calendar" aria-hidden="true"></span></div>
    <div class="rv-booking-ticket rv-glass rv-glass--strong" data-rv-single-ticket>
      <img src="{{ basePath }}{{ bookingDefault.service.image }}" alt="" data-rv-ticket-image>
      <div class="rv-booking-ticket__body"><h2 data-rv-ticket-service>{{ bookingDefault.service.name }}</h2><p class="rv-muted" data-rv-ticket-stylist>با {{ bookingDefault.stylist.name }}</p><strong data-rv-ticket-time></strong></div>
    </div>
    <div class="rv-booking-desktop-only rv-booking-ticket-address"><span class="ri ri-map-pin" aria-hidden="true"></span><span>{{ bookingContact.address }}</span></div>
    <section class="rv-panel" data-rv-group-ticket hidden><h2>خلاصه رزرو دوره‌ای</h2><ol class="rv-booking-group" data-rv-group-items></ol></section>
  </div>
  <aside class="rv-booking-summary" aria-label="خلاصهٔ پرداخت">
    <section class="rv-panel rv-booking-hold" aria-label="زمان نگه‌داشت" data-rv-hold>
      <div><span><span class="ri ri-hourglass" aria-hidden="true"></span>نگه‌داشت آزمایشی</span><bdi data-rv-hold-clock>۵:۰۰</bdi></div>
      <progress data-rv-hold-progress max="300" value="300" aria-label="مهلت باقی‌مانده"></progress>
    </section>
    <div class="rv-panel rv-booking-prices">
      <div class="rv-booking-desktop-only rv-booking-summary-head"><h2>هزینهٔ رزرو</h2><span class="ri ri-card" aria-hidden="true"></span></div>
      <dl><div><dt>هزینه رزرو</dt><dd data-rv-price-total></dd></div><div><dt>از اعتبار شما</dt><dd data-rv-price-credit></dd></div><div><dt>مانده برای درگاه</dt><dd data-rv-price-due></dd></div></dl>
      <p class="rv-muted">اعتبار موجود به‌صورت خودکار تا سقف هزینهٔ رزرو مصرف می‌شود. این مبلغ هزینهٔ رزرو است.</p>
    </div>
    <p class="rv-booking__notice rv-booking__notice--warning" data-rv-gateway-note hidden>درگاه پاسخ نداد. نگه‌داشت زمان تا پایان مهلت ادامه دارد.</p>
    <p class="rv-booking-rules rv-booking-mobile-only"><span class="ri ri-shield" aria-hidden="true"></span>پرداخت یعنی پذیرش <a class="rv-text-link" href="{{ productUrls.rules }}">قوانین رزرو</a></p>
    <div class="rv-booking-action rv-glass rv-glass--strong">
      <div><p class="rv-muted">مبلغ قابل پرداخت آزمایشی</p><strong data-rv-action-title></strong></div>
      <button class="rv-btn rv-booking-pay" type="submit" data-rv-booking-submit disabled>پرداخت آزمایشی</button>
    </div>
    <p class="rv-booking-rules rv-booking-desktop-only"><span class="ri ri-shield" aria-hidden="true"></span>پرداخت یعنی پذیرش <a class="rv-text-link" href="{{ productUrls.rules }}">قوانین رزرو</a></p>
  </aside>
</form>
