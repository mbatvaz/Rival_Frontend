<section class="rv-sheet rv-profile-sheet" id="rv-profile-password" role="dialog" aria-modal="true" aria-labelledby="rv-profile-password-title" aria-describedby="rv-profile-password-lead" tabindex="-1" hidden>
  <span data-rv-sheet-grip aria-hidden="true"></span>
  <div class="rv-sheet__header">
    <span class="rv-icon-tile" aria-hidden="true"><span class="ri ri-key"></span></span>
    <div class="rv-profile__value">
      <h2 id="rv-profile-password-title" data-profile-sheet-title>تنظیم رمز عبور</h2>
      <p class="rv-muted" id="rv-profile-password-lead" data-profile-sheet-lead>برای ورود با شماره و رمز</p>
    </div>
    <button class="rv-icon-btn rv-profile__plain" type="button" data-rv-sheet-close aria-label="بستن"><span class="ri ri-x" aria-hidden="true"></span></button>
  </div>
  <form class="rv-profile-sheet__form" method="post" data-profile-form="password" novalidate>
    {% for field in [{ id: "password", label: "رمز تازه" }, { id: "confirmPassword", label: "تکرار رمز تازه" }] %}
      <div class="rv-field">
        <label for="profile-{{ field.id }}">{{ field.label }}</label>
        <div class="rv-input">
          <span class="ri ri-lock" aria-hidden="true"></span>
          <input id="profile-{{ field.id }}" name="{{ field.id }}" dir="ltr" type="password" autocomplete="new-password" maxlength="128" required{% if loop.first %} aria-describedby="profile-password-rule" data-rv-sheet-initial-focus{% else %} placeholder="دوباره بنویسید"{% endif %}>
          <button class="rv-icon-btn rv-profile__plain" type="button" data-profile-show-password aria-label="نمایش {{ field.label }}" aria-pressed="false"><span class="ri ri-eye-off" aria-hidden="true"></span></button>
        </div>
        {% if loop.first %}<small class="rv-muted" id="profile-password-rule">دست‌کم ۸ نویسه، با حرف و عدد</small>{% endif %}
      </div>
    {% endfor %}
    <p class="rv-profile-sheet__note"><span class="ri ri-sms" aria-hidden="true"></span>کد پیامکی همیشه فعال می‌ماند؛ رمز فقط یک راه دیگر برای ورود است.</p>
    <p class="rv-feedback rv-feedback--error" data-profile-form-error role="alert"></p>
    <div class="rv-actions">
      <button class="rv-btn" type="submit" data-profile-submit>ذخیره رمز</button>
      <button class="rv-btn rv-btn--secondary" type="button" data-rv-sheet-close>انصراف</button>
    </div>
  </form>
</section>
