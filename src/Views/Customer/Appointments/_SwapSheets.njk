<section class="rv-sheet rv-appointment-swap" id="rv-swap-create" role="dialog" aria-modal="true" aria-labelledby="rv-swap-create-title" tabindex="-1" hidden>
  <header class="rv-sheet__header">
    <h2 id="rv-swap-create-title">ایجاد کد تعویض نوبت</h2>
    <button type="button" class="rv-icon-btn" data-rv-sheet-close aria-label="بستن برگه ایجاد کد"><span class="ri ri-x" aria-hidden="true"></span></button>
  </header>
  <p class="rv-feedback rv-feedback--error" data-rv-swap-error role="alert"></p>
  <p class="rv-feedback" data-rv-swap-status role="status"></p>
  <form method="post" action="{{ customerUrls['CUS-04'] }}" data-rv-swap-form hidden>
    <!-- MVC:ANTIFORGERY -->
    <ul class="rv-appointment-swap__rules">
      <li>با ساخت کد، به مشتری واجد شرایط اجازه می‌دهید نوبتش را داوطلبانه با نوبت شما عوض کند.</li>
      <li>روز نوبتی را که می‌خواهید بگیرید انتخاب کنید. ساعت آن آزاد است؛ آرایشگر باید یکسان و خدمت سازگار باشد.</li>
      <li>پرداخت‌کنندهٔ اولیه حق مالی و بازگشت هزینه را دارد. صاحب فعلی نوبت آن را مدیریت می‌کند و سهم جابه‌جایی نوبت حفظ می‌شود.</li>
      <li>در صورت عدم حضور مشتری جدید، مقررات عدم حضور سالن اعمال می‌شود.</li>
      <li>هر توافق مالی خصوصی، طبق قانون، بر عهدهٔ خود مشتریان است.</li>
      {% include "Customer/Appointments/_SwapSalonRule.njk" %}
    </ul>
    <div class="rv-field">
      <span id="rv-swap-date-label">تاریخ نوبتی که می‌خواهید بگیرید</span>
      <button type="button" class="rv-btn rv-btn--secondary" data-rv-swap-date aria-labelledby="rv-swap-date-label rv-swap-date-value" aria-haspopup="dialog"><span class="ri ri-calendar" aria-hidden="true"></span><span id="rv-swap-date-value">انتخاب تاریخ</span></button>
      <input type="hidden" name="desiredDate">
    </div>
    <button class="rv-btn" type="submit" disabled>موافقت و ایجاد کد</button>
  </form>
  <div data-rv-swap-offer hidden>
    <h3 tabindex="-1">کد تعویض شما</h3>
    <p class="rv-appointment-swap__code rv-panel"><bdi data-rv-swap-code></bdi></p>
    <button type="button" class="rv-btn rv-btn--secondary" data-rv-swap-copy>کپی کد</button>
    <div class="rv-customer-payment__hold">
      <div><span class="rv-customer-payment__badge"><span class="ri ri-hourglass" aria-hidden="true"></span>اعتبار کد تعویض</span><span><bdi data-rv-swap-timer role="timer" aria-live="off"></bdi> زمان باقی‌مانده</span></div>
      <progress value="0" max="600" data-rv-swap-progress aria-label="مهلت کد تعویض"></progress>
    </div>
    <p>تاریخ درخواستی <bdi data-rv-swap-target></bdi></p>
    <p>این کد فقط یک‌بار قابل استفاده است.</p>
  </div>
</section>
<section class="rv-sheet rv-appointment-swap" id="rv-swap-redeem" role="dialog" aria-modal="true" aria-labelledby="rv-swap-redeem-title" tabindex="-1" hidden>
  <header class="rv-sheet__header">
    <h2 id="rv-swap-redeem-title" tabindex="-1">ثبت کد تعویض نوبت</h2>
    <button type="button" class="rv-icon-btn" data-rv-sheet-close aria-label="بستن برگه تعویض"><span class="ri ri-x" aria-hidden="true"></span></button>
  </header>
  <form method="post" action="{{ customerUrls['CUS-04'] }}" data-rv-swap-form>
    <!-- MVC:ANTIFORGERY -->
    <ul class="rv-appointment-swap__rules">
      <li>با تأیید تعویض، نوبتِ صاحب کد به شما می‌رسد و نوبت فعلی شما به او. تاریخ و ساعت هر دو نوبت ثابت می‌ماند.</li>
      <li>حقوق مالی و بازگشت هزینه برای پرداخت‌کنندهٔ اولیه است. مدیریت هر نوبت به صاحب فعلی آن می‌رسد و سهم جابه‌جایی حفظ می‌شود.</li>
      <li>مدیریت و حضور در نوبتی که می‌گیرید، طبق مقررات سالن، بر عهدهٔ شماست.</li>
      {% include "Customer/Appointments/_SwapSalonRule.njk" %}
    </ul>
    <label class="rv-field">
      <span>کد تعویض دریافتی</span>
      <input class="rv-input" name="code" dir="ltr" autocomplete="off" spellcheck="false" maxlength="80" required aria-describedby="rv-swap-redeem-error">
    </label>
    <button class="rv-btn" type="submit">بررسی کد تعویض</button>
  </form>
  <form method="post" action="{{ customerUrls['CUS-04'] }}" data-rv-swap-confirm hidden>
    <!-- MVC:ANTIFORGERY -->
    <dl class="rv-panel rv-appointment-swap__dates">
      <div><dt>نوبتی که واگذار می‌کنید</dt><dd data-rv-swap-current></dd></div>
      <div><dt>نوبتی که دریافت می‌کنید</dt><dd data-rv-swap-incoming></dd></div>
    </dl>
    <p class="rv-muted" data-rv-swap-preview-note hidden>این یک پیش‌نمایش است.</p>
    <div class="rv-actions">
      <button class="rv-btn" type="submit">موافقت و تعویض نوبت</button>
      <button class="rv-btn rv-btn--secondary" type="button" data-rv-swap-edit>بازگشت به کد</button>
    </div>
  </form>
  <p class="rv-feedback rv-feedback--error" id="rv-swap-redeem-error" data-rv-swap-error role="alert"></p>
  <div class="rv-appointment-swap__result" data-rv-swap-result hidden>
    <span class="rv-icon-tile" aria-hidden="true"><span class="ri ri-check"></span></span>
    <p role="status" data-rv-swap-success tabindex="-1"></p>
    <p>نوبت دریافتی <strong data-rv-swap-booked></strong></p>
    <p class="rv-muted" data-rv-swap-preview-note hidden>این یک پیش‌نمایش است.</p>
    <div class="rv-actions">
      <a class="rv-btn" href="{{ customerUrls['CUS-04'] }}" data-rv-swap-received>مشاهده نوبت دریافتی</a>
      <a class="rv-btn rv-btn--secondary" href="{{ customerUrls['CUS-03'] }}" data-rv-swap-list>نوبت‌های من</a>
    </div>
  </div>
</section>
<section class="rv-sheet rv-appointment-date rv-appointment-swap__calendar" id="rv-swap-calendar" role="dialog" aria-modal="true" aria-labelledby="rv-swap-calendar-title" tabindex="-1" hidden>
  <header class="rv-sheet__header">
    <h2 id="rv-swap-calendar-title">انتخاب تاریخ نوبت دریافتی</h2>
    <button type="button" class="rv-icon-btn" data-rv-sheet-close aria-label="بازگشت به ایجاد کد"><span class="ri ri-x" aria-hidden="true"></span></button>
  </header>
  {% include "Booking/_Calendar.njk" %}
</section>
