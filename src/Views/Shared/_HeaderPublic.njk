<header class="rv-public-header {% if isHome %}rv-public-header--home{% endif %}">
  {% if publicTitle %}<a class="rv-public-header__back" href="{{ urls.home }}" aria-label="بازگشت به خانه"><span class="ri ri-arrow-right" aria-hidden="true"></span></a>{% endif %}
  <a class="rv-public-header__logo" href="{{ urls.home }}" aria-label="ریوال — خانه"><img src="{{ urls.logo }}" alt="ریوال" width="120" height="40"></a>
  {% if publicTitle %}<h1 class="rv-public-header__title">{{ publicTitle }}</h1>{% endif %}
  <nav class="rv-public-header__nav" aria-label="ناوبری عمومی">
    <a href="{{ urls.home }}">خانه</a><a href="{{ productUrls.portfolio }}">نمونه‌کارها</a><a href="{{ productUrls.rules }}">قوانین رزرو</a>
  </nav>
  <a class="rv-btn rv-btn--small rv-btn--glass" href="{{ productUrls.login }}" data-rv-session-link>ورود یا ثبت‌نام</a>
</header>
