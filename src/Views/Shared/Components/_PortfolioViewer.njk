<section class="rv-sheet rv-viewer" id="{{ item.id }}" role="dialog" aria-modal="true" aria-labelledby="{{ item.id }}-title" tabindex="-1" hidden>
  <header class="rv-sheet__header"><h2 id="{{ item.id }}-title">{{ item.title }}</h2><button class="rv-icon-btn" type="button" data-rv-sheet-close aria-label="بستن نمایشگر"><span class="ri ri-x" aria-hidden="true"></span></button></header>
  <div class="rv-viewer__rail" data-rv="gallery-rail" tabindex="0" role="region" aria-label="تصاویر {{ item.title }}؛ برای دیدن بقیه بکشید">{% for image in item.images %}<figure><img src="{{ basePath }}{{ image }}" alt="{{ item.title }}؛ تصویر {{ loop.index | faDigits }}" width="312" height="390" loading="lazy" draggable="false"><figcaption>{{ loop.index | faDigits }} از {{ item.images.length | faDigits }}</figcaption></figure>{% endfor %}</div>
  <div class="rv-slide-dots" aria-hidden="true">{% for image in item.images %}<span data-rv-gallery-dot data-rv-active="{% if loop.first %}true{% else %}false{% endif %}"></span>{% endfor %}</div>
  <div class="rv-viewer__details">
    <h3>{{ item.title }}</h3><p class="rv-muted">{{ item.service }}{% if item.date %} <span aria-hidden="true">|</span> {{ item.date }}{% endif %}</p>
    <div class="rv-viewer__stylist">{% if item.avatar %}<img src="{{ basePath }}{{ item.avatar }}" alt="" width="48" height="48">{% else %}<span class="rv-icon-tile"><span class="ri ri-user" aria-hidden="true"></span></span>{% endif %}<div><strong>{{ item.stylist }}</strong><p class="rv-muted">آرایشگر</p></div></div>
    {% if item.description %}<p>{{ item.description }}</p>{% endif %}
  </div>
</section>
