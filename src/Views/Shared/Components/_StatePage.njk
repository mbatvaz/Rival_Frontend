<section class="rv-state-page rv-state-page--{{ statePage.tone }}" data-rv-result-view="{{ statePage.key }}" aria-labelledby="rv-state-title-{{ statePage.key }}"{% if statePage.hidden %} hidden{% endif %}>
  <div class="rv-state-page__intro">
    <span class="rv-icon-tile rv-icon-tile--large rv-state-page__icon rv-state-page__icon--{{ statePage.tone }}"><picture class="rv-icon-motion" aria-hidden="true"><source media="(prefers-reduced-motion: no-preference)" srcset="{{ basePath }}img/icon-motion/{{ statePage.icon }}-{{ statePage.tone }}.gif"><img src="{{ basePath }}icons/{{ statePage.icon }}.svg" alt="" width="40" height="40"></picture><span class="ri ri-{{ statePage.icon }} rv-icon-motion-static" aria-hidden="true"></span></span>
    {% if statePage.badge %}<span class="rv-state-page__badge">{% if statePage.badgeIcon %}<span class="ri ri-{{ statePage.badgeIcon }}" aria-hidden="true"></span>{% endif %}{{ statePage.badge }}</span>{% endif %}
    <h2 id="rv-state-title-{{ statePage.key }}">{{ statePage.title }}</h2>
    {% if statePage.description %}<p class="rv-lead">{{ statePage.description }}</p>{% endif %}
    {% if statePage.followup %}<p class="rv-muted">{{ statePage.followup }}</p>{% endif %}
  </div>
  {% if statePage.facts %}<ul class="rv-state-page__facts">{% for fact in statePage.facts %}<li><span class="ri ri-{{ fact.icon }}" aria-hidden="true"></span><span><strong>{{ fact.label }}</strong> {{ fact.text }}</span></li>{% endfor %}</ul>{% endif %}
  {% if statePage.reference and statePage.inlineReference %}
  <p class="rv-state-page__reference"><span>{{ statePage.reference.label }}</span><bdi data-rv-result-code dir="ltr">#{{ statePage.reference.value }}</bdi></p>
  {% endif %}
  {% if statePage.context or statePage.lines.length or (statePage.reference and not statePage.inlineReference) %}
  <div class="rv-state-page__receipt rv-panel">
    {% if statePage.context %}
    <div class="rv-state-page__context">
      {% if statePage.context.image %}<span class="rv-state-page__photo"><img src="{{ statePage.context.image }}" alt="" data-rv-result-image>{% if statePage.context.avatar %}<img src="{{ statePage.context.avatar }}" alt="" data-rv-result-avatar>{% endif %}</span>{% endif %}
      <div><strong data-rv-result-service>{{ statePage.context.title }}</strong>
      {% if statePage.context.subtitle %}<p class="rv-muted" data-rv-result-stylist>{{ statePage.context.subtitle }}</p>{% endif %}</div>
    </div>
    {% if statePage.context.showTime %}<p data-rv-result-time>{{ statePage.context.time }}</p>{% endif %}
    {% endif %}
    {% if statePage.lines.length %}
    <dl class="rv-state-page__lines">{% for line in statePage.lines %}<div><dt>{{ line.label }}</dt><dd{% if line.field and not line.previous %} data-rv-result-{{ line.field }}{% endif %}>{% if line.previous %}<del data-rv-result-{{ line.field }}>{{ line.value }}</del>{% else %}{{ line.value }}{% endif %}</dd></div>{% endfor %}</dl>
    {% endif %}
    {% if statePage.reference and not statePage.inlineReference %}<p class="rv-state-page__code"><span>{{ statePage.reference.label }}</span><bdi data-rv-result-code dir="ltr">#{{ statePage.reference.value }}</bdi></p>{% endif %}
  </div>
  {% endif %}
  {% if statePage.notice %}<p class="rv-state-page__notice"><span class="ri ri-{{ statePage.notice.icon }}" aria-hidden="true"></span>{{ statePage.notice.text }}</p>{% endif %}
  <div class="rv-actions rv-state-page__actions">
    {% for action in statePage.actions %}<a class="rv-btn{% if action.secondary %} rv-btn--secondary{% endif %}" href="{{ action.href }}"{% if action.id %} data-rv-result-action="{{ action.id }}"{% endif %}>{{ action.label }}</a>{% endfor %}
  </div>
</section>
