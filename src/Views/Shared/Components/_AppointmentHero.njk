{# CUS-01 / AppointmentHero, Batch 3; single canonical hero for future consumers. #}
<article class="rv-appointment-hero" role="listitem" data-rv-appointment="{{ appointment.id }}" aria-label="{{ appointment.service }} با {{ appointment.stylist }}، {{ appointment.weekday }} {{ appointment.day }} {{ appointment.month }} ساعت {{ appointment.time }}">
  <div class="rv-appointment-hero__media"><img src="{{ basePath }}{{ appointment.image }}" alt="" width="322" height="152"{% if not loop.first %} loading="lazy"{% endif %}><span class="rv-appointment-hero__tag"><span class="ri ri-calendar-clock" aria-hidden="true"></span>{{ appointment.distance }}</span></div>
  <div class="rv-appointment-hero__panel">
    <div class="rv-appointment-hero__when"><div class="rv-appointment-hero__date"><b>{{ appointment.day }}</b><span>{{ appointment.weekday }}</span><small>{{ appointment.month }}</small></div><div class="rv-appointment-hero__time"><b>{{ appointment.time }}</b><div class="rv-appointment-countdown" role="timer" aria-label="زمان مانده به نوبت" data-rv-home-countdown="{{ appointment.id }}">{% for unit in appointment.countdown %}<span><b>{{ unit.value }}</b><small>{{ unit.label }}</small></span>{% endfor %}</div></div></div>
    <div class="rv-appointment-hero__service"><img src="{{ basePath }}{{ appointment.avatar }}" alt="" width="32" height="32" loading="lazy"><div><h2 data-rv-overflow-text>{{ appointment.service }}</h2><p>با {{ appointment.stylist }}</p></div><a class="rv-icon-btn" href="{{ customerMapUrl }}" aria-label="مسیریابی تا سالن"><span class="ri ri-map-pin" aria-hidden="true"></span></a></div>
    <div class="rv-appointment-hero__actions"><a class="rv-btn" href="{{ customerUrls['CUS-04'] }}?appointment={{ appointment.id }}">جزئیات نوبت</a><a class="rv-btn rv-btn--secondary" data-rv-home-write-action href="{{ customerUrls['CUS-04'] }}?appointment={{ appointment.id }}&amp;state=rsc">جابه‌جایی</a></div>
    <p class="rv-customer-reason" data-rv-home-inactive hidden><span class="ri ri-lock" aria-hidden="true"></span>{{ model.inactive.appointmentReason }}</p>
  </div>
</article>
