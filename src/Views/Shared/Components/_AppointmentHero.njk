{# CUS-01/CUS-04 / AppointmentHero, Batch 3. #}
<article class="rv-appointment-hero"{% if not detailHero %} role="listitem" data-rv-appointment="{{ appointment.id }}"{% endif %} aria-label="{{ appointment.service }} با {{ appointment.stylist }}، {{ appointment.weekday }} {{ appointment.day }} {{ appointment.month }} ساعت {{ appointment.time }}">
  <div class="rv-appointment-hero__media"><img src="{{ basePath }}{{ appointment.image }}" alt="" width="322" height="152"{% if not detailHero and not loop.first %} loading="lazy"{% endif %}><span class="rv-appointment-hero__tag{% if detailHero %} rv-appointment-status{% endif %}"{% if detailHero %} data-rv-tone="{{ appointment.tone }}"{% endif %}><span class="ri ri-{% if detailHero %}{{ appointment.icon }}{% else %}calendar-clock{% endif %}" aria-hidden="true"></span>{% if detailHero %}{{ appointment.statusText }}{% else %}{{ appointment.distance }}{% endif %}</span></div>
  <div class="rv-appointment-hero__panel">
    <div class="rv-appointment-hero__when"><div class="rv-appointment-hero__date"><b>{{ appointment.day }}</b><span>{{ appointment.detail.weekday or appointment.weekday }}</span><small>{{ appointment.month }}</small></div><div class="rv-appointment-hero__time"><b>{{ appointment.time }}</b>{% if appointment.countdown.length %}<div class="rv-appointment-countdown" role="timer" aria-label="زمان مانده به نوبت"{% if not detailHero %} data-rv-home-countdown="{{ appointment.id }}"{% endif %}>{% for unit in appointment.countdown %}<span><b>{{ unit.value }}</b><small>{{ unit.label }}</small></span>{% endfor %}</div>{% endif %}</div></div>
    {% if detailHero %}<p class="rv-appointment-detail__previous rv-muted" data-rv-detail-previous hidden>جابه‌جا شده از <del></del></p>{% endif %}
    <div class="rv-appointment-hero__service"><img src="{{ basePath }}{{ appointment.avatar }}" alt="" width="32" height="32" loading="lazy"><div><h2 data-rv-overflow-text>{{ appointment.service }}</h2><p>با {{ appointment.stylist }}{% if appointment.detail.duration %}<span class="rv-appointment-detail__duration">{{ appointment.detail.duration }}</span>{% endif %}</p></div>{% if not detailHero or appointment.status == 'booked' %}<a class="rv-icon-btn" href="{{ customerMapUrl }}" aria-label="مسیریابی تا سالن"><span class="ri ri-map-pin" aria-hidden="true"></span></a>{% endif %}</div>
    {% if not detailHero %}
    <div class="rv-appointment-hero__actions"><a class="rv-btn" href="{{ customerUrls['CUS-04'] }}?appointment={{ appointment.id }}" data-rv-home-detail>جزئیات نوبت</a><a class="rv-btn rv-btn--secondary" data-rv-home-write-action href="{{ customerUrls['CUS-04'] }}?appointment={{ appointment.id }}&amp;state=rsc">جابه‌جایی</a></div>
    <p class="rv-customer-reason" data-rv-home-inactive hidden><span class="ri ri-lock" aria-hidden="true"></span>{{ model.inactive.appointmentReason }}</p>
    {% endif %}
  </div>
</article>
