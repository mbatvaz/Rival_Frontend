<div class="rv-home-carousel" data-rv="home-carousel" data-rv-interval="{{ model.carouselInterval }}" role="region" aria-roledescription="چرخ‌فلک" aria-label="نمونه‌کارهای منتخب">
  <div class="rv-home-carousel__stage">
    {% for work in model.featured %}<figure class="rv-home-carousel__card" data-rv-carousel-card data-rv-position="{{ loop.index0 }}" {% if not loop.first %}aria-hidden="true"{% endif %}><img src="{{ basePath }}{{ work.image }}" alt="{{ work.title }}" width="260" height="350"><figcaption><a class="rv-glass rv-glass--strong" href="{{ productUrls.portfolio }}" {% if not loop.first %}hidden{% endif %}>{{ work.title }}</a></figcaption></figure>{% endfor %}
  </div>
  <div class="rv-home-carousel__controls"><button class="rv-icon-btn" type="button" data-rv-carousel-prev aria-label="نمونه‌کار قبلی"><span class="ri ri-arrow-right" aria-hidden="true"></span></button><button class="rv-text-link rv-auth-link" type="button" data-rv-carousel-pause>توقف حرکت</button><button class="rv-icon-btn" type="button" data-rv-carousel-next aria-label="نمونه‌کار بعدی"><span class="ri ri-arrow-left" aria-hidden="true"></span></button></div>
</div>
