{% extends "Shared/_Layout.njk" %}
{% block content %}
  <header class="rv-preview__intro">
    <img class="rv-preview__logo" src="{{ urls.logo }}" alt="ریوال" width="150" height="50">
    <p class="rv-preview__eyebrow">محیط بازبینی · فاز اول</p>
    <h1>فهرست صفحات و مسیرهای پروژه</h1>
    <p>دسترسی به {{ model.count | faDigits }} صفحه و حالت طراحی‌شدهٔ ریوال</p>
    <p class="rv-preview__notice">این نسخه آزمایشی است. صفحات محصول هنوز پیاده‌سازی نشده‌اند و رزرو یا پرداخت واقعی انجام نمی‌شود.</p>
    <a class="rv-preview__action" href="{{ urls.home }}"><span class="ri ri-arrow-left" aria-hidden="true"></span>مشاهده مسیر صفحه اصلی</a>
  </header>
  <div class="rv-preview__groups">
    {% for group in model.groups %}
      <section class="rv-preview__group">
        <h2>{{ group.name }}</h2>
        <ul class="rv-preview__list">
          {% for entry in group.pages %}
            {% include "Shared/Preview/_DirectoryEntry.njk" %}
          {% endfor %}
        </ul>
      </section>
    {% endfor %}
  </div>
{% endblock %}
