<!doctype html>
<html lang="fa" dir="rtl" data-rv-base-path="{{ site.basePath }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="ریوال، سالن مردانه طاها در اردبیل؛ معرفی سالن و رزرو">
  <title>{{ title }}</title>
  <link rel="icon" href="{{ urls.favicon }}">
  <link rel="preload" href="{{ site.basePath }}fonts/YekanBakh-Regular.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ site.basePath }}fonts/YekanBakh-SemiBold.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ site.basePath }}fonts/YekanBakh-Light.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ urls.css }}">
  {% block pageStyles %}{% endblock %}
  <script src="{{ site.basePath }}js/core/first-render.js"></script>
  <script type="module" data-rv-app-script src="{{ urls.js }}"></script>
</head>
<body>
  <a class="rv-skip-link" href="#rv-main">رفتن به محتوای اصلی</a>
  {% block body %}{% endblock %}
</body>
</html>
