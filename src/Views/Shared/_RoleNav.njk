<nav class="rv-role-nav" aria-label="ناوبری اصلی {{ shell.label }}"{% if shell.book %} data-rv="customer-dock" data-rv-customer-dock{% endif %}>
  {% if shell.book %}
  <div class="rv-customer-dock__tabs"><span class="rv-customer-dock__indicator" aria-hidden="true"></span>
    {% for item in shell.primary %}<a href="{{ item.href }}" aria-label="{{ item.title }}"{% if item.active %} aria-current="page" data-rv-nav-active="true"{% endif %}><span class="ri ri-{{ item.icon }}" aria-hidden="true"></span><span class="rv-customer-dock__label">{{ item.title }}</span></a>{% endfor %}
    <button type="button" data-rv-sheet-open="rv-more" aria-label="بیشتر"{% if shell.moreActive %} data-rv-nav-active="true"{% endif %}><span class="ri ri-menu" aria-hidden="true"></span><span class="rv-customer-dock__label">بیشتر</span></button>
  </div>
  <a class="rv-role-nav__book" href="{{ shell.book.href }}" aria-label="رزرو نوبت"><span class="ri ri-calendar-plus" aria-hidden="true"></span>رزرو</a>
  {% else %}
  {% for item in shell.primary %}
    <a href="{{ item.href }}" {% if item.active %}aria-current="page"{% endif %}><span class="ri ri-{% if shell.book and item.icon == 'send' %}inbox{% else %}{% if shell.book and item.icon == 'calendar' %}scissors{% else %}{{ item.icon }}{% endif %}{% endif %}" aria-hidden="true"></span><span>{{ item.title }}</span></a>
  {% endfor %}
  <button type="button" data-rv-sheet-open="rv-more"><span class="ri ri-menu" aria-hidden="true"></span><span>بیشتر</span></button>
  {% endif %}
</nav>
